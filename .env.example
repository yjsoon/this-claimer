# HowMuch is the default claims backend
HOWMUCH_PAT=hm_pat_your-personal-token-here
HOWMUCH_PLAN_ID=your-plan-id-here

# Optional YNAB fallback backend
# Get your API key from: https://app.ynab.com/settings/developer
YNAB_API_KEY=your-api-key-here

# Your YNAB budget ID (from URL when viewing budget: app.ynab.com/{budget_id}/...)
YNAB_BUDGET_ID=your-budget-id-here

# Gemini API key (for receipt amount tagging)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional Gemini model override (default in worker: gemini-3-flash-preview)
GEMINI_MODEL=gemini-3-flash-preview

# Receipt upload worker URL (your custom domain; workers.dev is turned off)
R2_WORKER_URL=https://receipts.yourdomain.com

# Receipt worker password
R2_PASSWORD=your-password-here

# Cloudflare Access service token, once the worker sits behind Access
# (docs/setup.md#cloudflare-access). Sent as CF-Access-Client-Id/-Secret.
CF_ACCESS_CLIENT_ID=your-service-token-id.access
CF_ACCESS_CLIENT_SECRET=your-service-token-secret

# Volopay base URL (your company's Volopay subdomain)
VOLOPAY_URL=https://yourcompany.volopay.co
