# Local secrets for `wrangler dev` (copy to .dev.vars, which is gitignored).
# In production these are set with `wrangler secret put <NAME>` instead.
#
# Xero app credentials — same app as the local ../../xero project. In the Xero
# developer portal, add BOTH redirect URIs to the app:
#   https://receipts.soon.sg/xero/callback   (production)
#   http://localhost:8787/xero/callback       (wrangler dev default port)
XERO_CLIENT_ID = "your-xero-client-id"
XERO_CLIENT_SECRET = "your-xero-client-secret"

# The web-app auth password (must match the deployed AUTH_PASSWORD secret) so
# the worker can be exercised locally.
AUTH_PASSWORD = "your-web-app-password"

# HowMuch is the default claims backend. Create a PAT in HowMuch under personal
# tokens; HOWMUCH_PLAN_ID may be omitted when it matches YNAB_BUDGET_ID.
# HOWMUCH_PAT = "hm_pat_..."
# HOWMUCH_PLAN_ID = "..."
# HOWMUCH_API_URL = "https://howmuch.tk.sg/v1"

# Optional: YNAB fallback + Gemini if you want those paths under `wrangler dev`.
# YNAB_API_KEY = "..."
# YNAB_BUDGET_ID = "..."
# GEMINI_API_KEY = "..."

# Optional: MiniMax coding-plan key (sk-cp-...) for amount extraction + GST
# detection on image receipts. Falls back to Gemini when missing. See
# VISION_PROVIDER in wrangler.toml.
# MINIMAX_API_KEY = "..."

# Optional: Gmail receipt import. The client can instead be pasted into the
# Gmail panel in the app. Google Cloud OAuth client (Web application)
# with the Gmail API enabled. Add BOTH redirect URIs to the client:
#   https://receipts.soon.sg/gmail/callback   (production)
#   http://localhost:8787/gmail/callback       (wrangler dev default port)
# GOOGLE_CLIENT_ID = "....apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET = "..."
# Optional: Cloudflare API token with "Browser Rendering - Edit", used to print
# Grab/Gojek email receipts to PDF. Without it those emails are skipped.
# CF_BROWSER_RENDERING_TOKEN = "..."
