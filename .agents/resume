#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# This repository has no local backing services or per-orb authentication to
# restore. Setup owns dependency installation; resume intentionally stays fast.
if [[ ! -d "$repo_root/scripts/node_modules" || ! -d "$repo_root/upload-app/node_modules" ]]; then
  echo "Dependencies are missing; run .agents/setup to restore them." >&2
  exit 1
fi

echo "Orb resume checks complete."
